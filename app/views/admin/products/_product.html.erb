<div id="<%= dom_id product %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= product.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= product.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Price:</strong>
    <%= product.price %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Category:</strong>
    <%= product.category_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Active:</strong>
    <%= product.active? ? "Yes" : "No" %>
  </div>

  <% if action_name != "show"%>
  <%= link_to "Show the product", [:admin, product], class: "rounded-lg py-3 px-5 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium"%>
  <%= link_to "Edit the product", edit_admin_product_path(product), class: "rounded-lg py-3 px-5 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium"%>
  <hr class="mt-6">
  <% end %>

</div>
