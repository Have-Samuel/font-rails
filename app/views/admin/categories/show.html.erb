<% content_for :title, "Showing category" %>
  <div class="mx-auto md:w-2/3 w-full flex">
    <div class="mx-auto">
      <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
      <% end %>

      <h1 class="font-bold text-4xl">Showing category</h1>

       <%= render @admin_category %>

       <%= link_to "Edit this category", edit_admin_category_path(@admin_category), class: "mt-2 rounded-md py-3 px-5 bg-gray-100 inline-block font-medium" %>

       <div class="inline-block ml-2">
       <%= button_to "Destroy this category", admin_category_path(@admin_category), method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "mt-2 rounded-lg py-3 px-5 bg-gray-100 font-medium hover:bg-gray-50" %>
       </div>
          <%= link_to "Back to categories", admin_categories_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
      </div>
    </div>

